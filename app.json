{
  "expo": {
    "name": "Flow Journal",
    "slug": "WITApp-FCM",
    "version": "7.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon2.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "App needs your location to save it in journal entries.",
        "NSPhotoLibraryUsageDescription": "App needs access to your photos to attach images to journal entries."
      }
    },
    "notification": {
      "icon": "./assets/icon2.png",
      "color": "#4CAF50",
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidCollapsedTitle": "Flow Journal"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon2.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.witapp.fcm",
      "versionCode": 7,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/Logo.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-maps",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon2.png",
          "color": "#4CAF50",
          "sounds": []
        }
      ],
      [
        "expo-background-fetch",
        {
          "backgroundFetchInterval": 15
        }
      ]
    ],
    "owner": "mberzah88",
    "extra": {
      "eas": {
        "projectId": "70562018-2bef-4ecf-9fa9-655aaa441455"
      }
    }
  }
}
